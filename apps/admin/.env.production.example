# Production admin build. Copy to apps/admin/.env.production before `pnpm build`.
# Vite bakes these values into the static files. Do not put API secrets here.

VITE_API_BASE_URL=https://api.example.com
VITE_APP_ENV=production

# Razorpay Key ID only (never put KEY_SECRET in the admin build)
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

