# Local API credentials. Copy to apps/api/.env.
# This talks to the PostgreSQL database from docker-compose.yml.
# Do not use these values when APP_ENV=production. Use .env.production.example.

DATABASE_URL=postgresql://redi:redi_local_dev@localhost:5432/redi?schema=public
# Same as DATABASE_URL for local Postgres. On Railway/Neon, use the non-pooled URL.
DIRECT_URL=postgresql://redi:redi_local_dev@localhost:5432/redi?schema=public
JWT_SECRET=dev-change-me
JWT_EXPIRES_IN=7d
LEARNER_JWT_SECRET=dev-learner-change-me
LEARNER_JWT_EXPIRES_IN=30d
PORT=3333
CORS_ORIGIN=http://localhost:5173
APP_ENV=local
OFFLINE_GRANT_SECRET=dev-offline-change-me
OFFLINE_GRANT_KID=redi-offline-v1
PROTECTED_CONTENT_BASE_URL=http://localhost:3333/api/protected/delivery
DOWNLOAD_SESSION_TTL_SECONDS=900
OFFLINE_DOCUMENT_TTL_SECONDS=604800
OFFLINE_VIDEO_TTL_SECONDS=259200

# Leave unset until a real provider is chosen. The API then reports capability unavailable.
# Live classes (Daily.co): https://dashboard.daily.co → Developers → API key
# LIVE_PROVIDER_BASE_URL=https://api.daily.co/v1
# DAILY_API_KEY=
# PUSH_PROVIDER_KEY=
# PAYMENT_PROVIDER_KEY=

# Razorpay Standard Checkout (test keys from dashboard.razorpay.com)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx


# Object storage for protected PDFs/notes/audio = Cloudinary (same CLOUDINARY_* below).
OBJECT_STORAGE_PROVIDER=cloudinary
# Optional folder for raw file uploads (default redi/storage)
# CLOUDINARY_FILES_FOLDER=redi/storage
# Optional time-limited delivery tokens (Cloudinary → Settings → Security)
# CLOUDINARY_AUTH_TOKEN_KEY=

# Email (OTP, password reset, class/result templates) — DB outbox + in-process worker.
# Local default: console (OTP appears in API logs). Production: brevo + verified From address.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=brevo
# EMAIL_PROVIDER_KEY=xkeysib-CHANGE_ME
# EMAIL_FROM_NAME=REDI
# EMAIL_FROM_ADDRESS=your.verified@gmail.com
# EMAIL_FROM=REDI <your.verified@gmail.com>
EMAIL_REQUIRE_VERIFY=true
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=5000

# Video (Mux) — admin uploads go directly to Mux, learners get signed HLS.
# Get these from mux.com → Dashboard → Settings → API Access Tokens / Signing Keys.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE_KEY=
#
# Cloudinary — video BACKUP + object storage for PDFs/raw files.
# Get these from cloudinary.com → Dashboard.
# VIDEO_PROVIDER=auto
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=redi/videos
