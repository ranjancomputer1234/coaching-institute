# Local API credentials. Copy to apps/api/.env.
# This talks to the PostgreSQL database from docker-compose.yml.
# Do not use these values when APP_ENV=production. Use .env.production.example.

DATABASE_URL=postgresql://redi:redi_local_dev@localhost:5432/redi?schema=public
JWT_SECRET=dev-change-me
JWT_EXPIRES_IN=7d
LEARNER_JWT_SECRET=dev-learner-change-me
LEARNER_JWT_EXPIRES_IN=30d
PORT=3333
CORS_ORIGIN=http://localhost:5173
APP_ENV=local
OFFLINE_GRANT_SECRET=dev-offline-change-me
OFFLINE_GRANT_KID=redi-offline-v1
PROTECTED_CONTENT_BASE_URL=http://localhost:3333/api/protected/delivery
DOWNLOAD_SESSION_TTL_SECONDS=900
OFFLINE_DOCUMENT_TTL_SECONDS=604800
OFFLINE_VIDEO_TTL_SECONDS=259200

# Leave unset until a real provider is chosen. The API then reports capability unavailable.
# LIVE_PROVIDER_BASE_URL=
# PUSH_PROVIDER_KEY=
# PAYMENT_PROVIDER_KEY=
# OBJECT_STORAGE_BUCKET=

# Video (Mux) — admin uploads go directly to Mux, learners get signed HLS.
# Get these from mux.com → Dashboard → Settings → API Access Tokens / Signing Keys.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE_KEY=
#
# Video BACKUP provider (Cloudinary) — used automatically when MUX_* is unset
# or Mux is unreachable. Get these from cloudinary.com → Dashboard.
# VIDEO_PROVIDER=auto
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=redi/videos
