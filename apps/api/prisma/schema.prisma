generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// —— Content lifecycle (shared) ——
enum ContentLifecycle {
  draft
  in_review
  changes_requested
  approved
  scheduled
  published
  unpublished
  archived
}

enum LearnerAccountState {
  pending_verification
  active
  suspended
  deletion_requested
  deleted
  blocked
}

enum ExploreCategory {
  learn
  prepare
  discover
}

enum CourseDeliveryType {
  standard
  semester_certification
}

enum CourseCommercialMode {
  free
  paid
  included
  invite_only
  hidden_internal
}

enum BannerPlacement {
  hero
  compact
  live_class
  modal
}

enum AuditSeverity {
  info
  notice
  warning
  high
  critical
}

// —— Admin identity & RBAC ——
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles        AdminRoleAssignment[]
  auditEvents  AuditEvent[]          @relation("AuditActor")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  admins      AdminRoleAssignment[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminRoleAssignment {
  adminId String
  roleId  String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role    Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
}

// —— Learners & batches ——
model Batch {
  id        String    @id @default(cuid())
  code      String?   @unique
  name      String
  subject   String?
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id])
  startDate DateTime?
  endDate   DateTime?
  timezone  String    @default("Asia/Kolkata")
  capacity  Int?
  status    String    @default("active")
  tagsJson  String    @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  learners    Learner[]
  memberships BatchMembership[]
  liveClasses LiveClass[]
}

model Learner {
  id              String              @id @default(cuid())
  firstName       String
  lastName        String
  email           String?             @unique
  phone           String?
  phoneNormalized String?
  city            String?
  accountState    LearnerAccountState @default(pending_verification)
  verifiedEmail   Boolean             @default(false)
  verifiedPhone   Boolean             @default(false)
  source          String?
  interestsJson   String              @default("[]")
  appVersion      String?
  lastActiveAt    DateTime?
  internalNotes   String?
  batchId         String?
  batch           Batch?              @relation(fields: [batchId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  memberships        BatchMembership[]
  enrollments        Enrollment[]
  attempts           Attempt[]
  projectSubmissions ProjectSubmission[]
  semesterProgress   SemesterProgress[]
  credential         LearnerCredential?
  lessonProgress     LessonProgress[]
  entitlements       Entitlement[]
  documents          IssuedDocument[]
  downloadSessions   DownloadSession[]
  offlineGrants      OfflineGrant[]
}

model LearnerCredential {
  id           String   @id @default(cuid())
  learnerId    String   @unique
  learner      Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BatchMembership {
  id        String   @id @default(cuid())
  batchId   String
  learnerId String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([batchId, learnerId])
}

// —— Courses & lessons ——
model Course {
  id             String               @id @default(cuid())
  slug           String               @unique
  title          String
  shortTitle     String?
  summary        String?
  description    String?
  language       String               @default("en")
  level          String?
  tagsJson       String               @default("[]")
  deliveryType   CourseDeliveryType   @default(standard)
  commercialMode CourseCommercialMode @default(free)
  lifecycle      ContentLifecycle     @default(draft)
  featured       Boolean              @default(false)
  estimatedMinutes Int?
  coverImageUrl  String?
  revision       Int                  @default(1)
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  lessons      Lesson[]
  batches      Batch[]
  enrollments  Enrollment[]
  semesters    SemesterDefinition[]
  projects     Project[]
  tests        Test[]
  resources    Resource[]
  entitlements Entitlement[]
}

model Lesson {
  id              String           @id @default(cuid())
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sortOrder       Int              @default(0)
  durationMinutes Int?
  contentType     String           @default("video")
  mediaUrl        String?
  isPreview       Boolean          @default(false)
  lifecycle       ContentLifecycle @default(draft)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  resources Resource[]
  progress  LessonProgress[]

  @@index([courseId, sortOrder])
}

model LessonProgress {
  id              String    @id @default(cuid())
  learnerId       String
  lessonId        String
  learner         Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status          String    @default("in_progress")
  progressPct     Float     @default(0)
  positionSeconds Int?
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([learnerId, lessonId])
  @@index([learnerId])
}

model Enrollment {
  id          String    @id @default(cuid())
  learnerId   String
  courseId    String
  learner     Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source      String    @default("manual")
  status      String    @default("active")
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([learnerId, courseId])

  semesterProgress SemesterProgress[]
  semesterReviews  SemesterReview[]
}

// —— Assessments (Phase 2) ——
enum QuestionType {
  single_choice
  multiple_choice
  true_false
  numeric
  short_text
  essay
}

enum QuestionStatus {
  draft
  approved
  retired
}

enum TestMode {
  practice
  formal
}

enum AttemptStatus {
  created
  in_progress
  submitted
  scored
  result_unpublished
  result_published
  expired
  abandoned
}

enum ProjectSubmissionStatus {
  not_started
  draft
  submitted
  accepted
  changes_required
}

enum SemesterStatus {
  locked
  available
  in_progress
  requirements_complete
  pending_review
  changes_required
  approved
  course_complete
}

model Question {
  id              String         @id @default(cuid())
  prompt          String
  type            QuestionType   @default(single_choice)
  explanation     String?
  subject         String?
  topic           String?
  difficulty      String?
  language        String         @default("en")
  marks           Float          @default(1)
  negativeMarks   Float          @default(0)
  status          QuestionStatus @default(draft)
  revision        Int            @default(1)
  tagsJson        String         @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  options       QuestionOption[]
  testQuestions TestQuestion[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int      @default(0)
  isCorrect  Boolean  @default(false)

  @@index([questionId, sortOrder])
}

model Test {
  id              String           @id @default(cuid())
  title           String
  description     String?
  mode            TestMode         @default(practice)
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id])
  semesterId      String?
  semester        SemesterDefinition? @relation(fields: [semesterId], references: [id])
  language        String           @default("en")
  instructions    String?
  questionCount   Int              @default(0)
  durationMinutes Int              @default(60)
  maxScore        Float            @default(0)
  passThreshold   Float            @default(40)
  negativeMarking Boolean          @default(false)
  attemptLimit    Int?
  lifecycle       ContentLifecycle @default(draft)
  resultPolicy    String           @default("after_manual_publish")
  startsAt        DateTime?
  endsAt          DateTime?
  revision        Int              @default(1)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questions TestQuestion[]
  attempts  Attempt[]
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  questionId String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])
  sortOrder  Int      @default(0)
  marks      Float?

  @@unique([testId, questionId])
  @@index([testId, sortOrder])
}

model Attempt {
  id              String        @id @default(cuid())
  testId          String
  learnerId       String
  test            Test          @relation(fields: [testId], references: [id])
  learner         Learner       @relation(fields: [learnerId], references: [id])
  status          AttemptStatus @default(created)
  startedAt       DateTime      @default(now())
  expiresAt       DateTime?
  submittedAt     DateTime?
  snapshotJson    String?
  answerRevision  Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  answers AttemptAnswer[]
  result  Result?

  @@index([testId, learnerId])
}

model AttemptAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  revision         Int      @default(1)
  answeredAt       DateTime @default(now())
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Result {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  rawScore      Float
  maxScore      Float
  percentage    Float
  passed        Boolean
  correctCount  Int
  wrongCount    Int
  skippedCount  Int
  scoringVersion Int     @default(1)
  published     Boolean  @default(false)
  publishedAt   DateTime?
  revision      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// —— Semesters, projects, reviews (Phase 2) ——
model SemesterDefinition {
  id                    String   @id @default(cuid())
  courseId              String
  course                Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  index                 Int
  title                 String
  description           String?
  expectedDays          Int?
  minTestScore          Float?
  requiresManualReview  Boolean  @default(true)
  unlockRule            String   @default("admin_approval")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  projects  Project[]
  tests     Test[]
  progress  SemesterProgress[]
  reviews   SemesterReview[]

  @@unique([courseId, index])
}

model SemesterProgress {
  id          String         @id @default(cuid())
  enrollmentId String
  semesterId  String
  learnerId   String
  enrollment  Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  semester    SemesterDefinition @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  learner     Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  status      SemesterStatus @default(locked)
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  @@unique([enrollmentId, semesterId])
}

model Project {
  id               String   @id @default(cuid())
  courseId         String
  semesterId       String?
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester         SemesterDefinition? @relation(fields: [semesterId], references: [id])
  title            String
  instructions     String?
  rubricJson       String   @default("[]")
  allowText        Boolean  @default(true)
  allowFiles       Boolean  @default(true)
  maxSubmissions   Int      @default(5)
  lifecycle        ContentLifecycle @default(draft)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id            String                  @id @default(cuid())
  projectId     String
  learnerId     String
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  learner       Learner                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  status        ProjectSubmissionStatus @default(submitted)
  textBody      String?
  fileMetaJson  String?
  revision      Int                     @default(1)
  predecessorId String?
  submittedAt   DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  reviews ProjectReview[]

  @@index([projectId, status])
}

model ProjectReview {
  id              String   @id @default(cuid())
  submissionId    String
  submission      ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decision        ProjectSubmissionStatus
  learnerFeedback String?
  internalNotes   String?
  reviewerId      String?
  reviewedAt      DateTime @default(now())
}

model SemesterReview {
  id              String   @id @default(cuid())
  enrollmentId    String
  semesterId      String
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  semester        SemesterDefinition @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  status          SemesterStatus @default(pending_review)
  checklistJson   String   @default("{}")
  learnerFeedback String?
  internalNotes   String?
  reviewerId      String?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

// —— Explore & banners ——
model ExploreSection {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  description      String?
  badge            String?
  category         ExploreCategory  @default(learn)
  iconKey          String?
  themeKey         String?
  imageUrl         String?
  accessibilityLabel String?
  targetKind       String
  targetRef        String
  pricingFilter    String           @default("all")
  sortOrder        Int              @default(0)
  featured         Boolean          @default(false)
  homeVisible      Boolean          @default(true)
  lifecycle        ContentLifecycle @default(draft)
  startsAt         DateTime?
  endsAt           DateTime?
  minAppVersion    String?
  locale           String           @default("en")
  revision         Int              @default(1)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Banner {
  id            String           @id @default(cuid())
  campaignName  String
  title         String
  subtitle      String?
  ctaLabel      String?
  placement     BannerPlacement  @default(hero)
  priority      Int              @default(100)
  imageUrl      String?
  altText       String?
  themeKey      String?
  targetKind    String
  targetRef     String
  audienceJson  String           @default("{\"type\":\"everyone\"}")
  lifecycle     ContentLifecycle @default(draft)
  startsAt      DateTime?
  endsAt        DateTime?
  locale        String           @default("en")
  revision      Int              @default(1)
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// —— Audit ——
model AuditEvent {
  id              String        @id @default(cuid())
  occurredAtUtc   DateTime      @default(now())
  actorType       String        @default("admin")
  actorId         String?
  actorDisplay    String?
  actor           AdminUser?    @relation("AuditActor", fields: [actorId], references: [id])
  sessionId       String?
  requestId       String?
  action          String
  resourceType    String
  resourceId      String?
  scope           String?
  beforeJson      String?
  afterJson       String?
  reason          String?
  outcome         String        @default("success")
  errorCode       String?
  severity        AuditSeverity @default(info)
  ip              String?
  userAgent       String?

  @@index([occurredAtUtc])
  @@index([action])
  @@index([resourceType, resourceId])
}

// —— Protected resources, entitlements, documents (learner API) ——
enum ResourceKind {
  pdf
  video
  audio
  notes
  other
}

enum DocumentType {
  admit_card
  certificate
  receipt
}

enum DocumentStatus {
  not_issued
  generation_pending
  generated
  approval_pending
  issued
  revoked
  superseded
  expired
  generation_failed
}

enum EntitlementState {
  active
  expired
  revoked
  pending
}

enum DrmScheme {
  none
  widevine
  fairplay
  provider
}

model MediaAsset {
  id              String     @id @default(cuid())
  storageKey      String
  mimeType        String
  byteSize        Int?
  checksumSha256  String?
  encryptionAlgo  String? // e.g. aes-256-gcm container hint for mobile
  packagingFormat String? // e.g. encrypted_pdf, dash_cenc, hls_fps, mux_hls
  drmScheme       DrmScheme  @default(none)
  drmContentId    String?
  licenseServiceUrl String?
  offlinePeriodSeconds Int?
  // Managed video provider (e.g. "mux"). Null for plain storage-key assets.
  provider          String?
  providerUploadId  String? @unique
  providerAssetId   String? @unique
  providerPlaybackId String? @unique
  providerStatus    String? // waiting | asset_created | preparing | ready | errored
  lifecycle       ContentLifecycle @default(draft)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  resources Resource[]
}

model Resource {
  id              String           @id @default(cuid())
  title           String
  kind            ResourceKind
  mimeType        String
  byteSize        Int?
  contentVersion  Int              @default(1)
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  mediaAssetId    String?
  mediaAsset      MediaAsset?      @relation(fields: [mediaAssetId], references: [id])
  downloadable    Boolean          @default(true)
  previewAllowed  Boolean          @default(false)
  lifecycle       ContentLifecycle @default(draft)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  downloadSessions DownloadSession[]
  offlineGrants    OfflineGrant[]
  documents        IssuedDocument[]

  @@index([courseId])
  @@index([lessonId])
}

model Entitlement {
  id          String           @id @default(cuid())
  learnerId   String
  learner     Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  productKey  String?
  scopeKind   String           @default("course") // course | resource | document
  scopeRef    String?
  source      String           @default("manual") // purchase | manual | scholarship | promotion | enrollment
  state       EntitlementState @default(active)
  canDownload Boolean          @default(true)
  canPreview  Boolean          @default(true)
  startsAt    DateTime         @default(now())
  endsAt      DateTime?
  grantReason String?
  revokeReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([learnerId, state])
  @@index([courseId])
}

model DocumentTemplate {
  id          String           @id @default(cuid())
  key         String
  version     Int              @default(1)
  title       String
  documentType DocumentType
  locale      String           @default("en")
  lifecycle   ContentLifecycle @default(draft)
  variablesJson String         @default("[]")
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  documents IssuedDocument[]

  @@unique([key, version])
}

model IssuedDocument {
  id              String         @id @default(cuid())
  learnerId       String
  learner         Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  documentType    DocumentType
  status          DocumentStatus @default(not_issued)
  serial          String?        @unique
  verificationToken String       @unique @default(cuid())
  title           String
  courseId        String?
  templateId      String?
  template        DocumentTemplate? @relation(fields: [templateId], references: [id])
  resourceId      String?
  resource        Resource?      @relation(fields: [resourceId], references: [id])
  issuedAt        DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime?
  revokeReason    String?
  snapshotJson    String         @default("{}")
  pdfSha256       String?
  issuedByAdminId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([learnerId, documentType, status])
  @@index([verificationToken])
}

model DownloadSession {
  id            String   @id @default(cuid())
  learnerId     String
  learner       Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  deliveryToken String   @unique
  expiresAt     DateTime
  deviceId      String?
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([learnerId, resourceId])
}

model OfflineGrant {
  id            String   @id @default(cuid())
  learnerId     String
  learner       Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  contentVersion Int
  deviceId      String?
  validFrom     DateTime @default(now())
  validUntil    DateTime
  kid           String   @default("redi-offline-v1")
  signature     String
  payloadJson   String
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([learnerId, resourceId])
}

// —— Editorial, live, communications, commerce, support, settings ——
enum EditorialKind {
  news
  awareness
  fact
  interview
}

enum LiveClassStatus {
  draft
  scheduled
  live
  ended
  cancelled
  provider_unavailable
}

model EditorialItem {
  id          String           @id @default(cuid())
  kind        EditorialKind
  title       String
  summary     String?
  body        String?
  category    String?
  lifecycle   ContentLifecycle @default(draft)
  publishedAt DateTime?
  revision    Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([kind, lifecycle])
}

model LiveClass {
  id                     String          @id @default(cuid())
  title                  String
  courseId               String?
  batchId                String?
  batch                  Batch?          @relation(fields: [batchId], references: [id])
  /// JSON string array of learner ids for a custom audience (subset of a batch or ad-hoc).
  audienceLearnerIdsJson String          @default("[]")
  startsAt               DateTime
  endsAt                 DateTime
  hostName               String?
  capacity               Int?
  status                 LiveClassStatus @default(draft)
  provider               String          @default("unconfigured")
  providerRoomId         String?
  joinUrl                String?
  recordingStatus        String          @default("not_available")
  notifyCampaignId       String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([batchId])
  @@index([startsAt])
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  key       String
  version   Int              @default(1)
  title     String
  body      String
  channel   String           @default("push")
  lifecycle ContentLifecycle @default(draft)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  campaigns NotificationCampaign[]

  @@unique([key, version])
}

model NotificationCampaign {
  id             String                @id @default(cuid())
  title          String
  audience       String                @default("single")
  audienceRef    String?
  templateId     String?
  template       NotificationTemplate? @relation(fields: [templateId], references: [id])
  body           String
  status         String                @default("draft")
  providerStatus String                @default("not_configured")
  failureReason  String?
  sentAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model Product {
  id         String           @id @default(cuid())
  sku        String           @unique
  title      String
  pricePaise Int
  currency   String           @default("INR")
  lifecycle  ContentLifecycle @default(draft)
  courseId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  orders Order[]
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int?
  amountOffPaise Int?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Order {
  id                String   @id @default(cuid())
  learnerId         String
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  status            String   @default("pending")
  amountPaise       Int
  currency          String   @default("INR")
  externalReference String?
  providerStatus    String   @default("not_configured")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refunds RefundRequest[]
}

model RefundRequest {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  reason      String
  status      String   @default("requested")
  amountPaise Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportCase {
  id        String   @id @default(cuid())
  learnerId String?
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
