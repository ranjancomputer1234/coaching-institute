# Production API credentials. Copy to the host secret store or apps/api/.env
# on the production machine only. Never commit the filled file.
#
# Replace every CHANGE_ME value. The three secrets must be different and
# at least 32 characters. The API refuses to start in production if they
# are missing, short, reused, or still placeholders.

APP_ENV=production
DATABASE_URL=postgresql://USER:CHANGE_ME@db.example.com:5432/redi?schema=public&sslmode=require
JWT_SECRET=CHANGE_ME_ADMIN_JWT_32_CHARS_MINIMUM
JWT_EXPIRES_IN=1d
LEARNER_JWT_SECRET=CHANGE_ME_LEARNER_JWT_32_CHARS_MINIMUM
LEARNER_JWT_EXPIRES_IN=30d
OFFLINE_GRANT_SECRET=CHANGE_ME_OFFLINE_HMAC_32_CHARS_MINIMUM
OFFLINE_GRANT_KID=redi-offline-v1
PORT=3333
CORS_ORIGIN=https://admin.example.com
PROTECTED_CONTENT_BASE_URL=https://api.example.com/api/protected/delivery
DOWNLOAD_SESSION_TTL_SECONDS=900
OFFLINE_DOCUMENT_TTL_SECONDS=604800
OFFLINE_VIDEO_TTL_SECONDS=259200

# Required before those features are treated as available.
# LIVE_PROVIDER_BASE_URL=https://api.daily.co/v1
# DAILY_API_KEY=CHANGE_ME
# PUSH_PROVIDER_KEY=CHANGE_ME
# EMAIL_PROVIDER_KEY=CHANGE_ME
# PAYMENT_PROVIDER_KEY=CHANGE_ME
# OBJECT_STORAGE_BUCKET=redi-protected-content

# Video (Mux) — required before admin video upload / signed streaming works.
# Mux Dashboard → Settings → API Access Tokens, and Settings → Signing Keys.
# On Railway, set these as Variables on the `api` service only. Never in the admin app.
# MUX_TOKEN_ID=CHANGE_ME
# MUX_TOKEN_SECRET=CHANGE_ME
# MUX_SIGNING_KEY_ID=CHANGE_ME
# MUX_SIGNING_KEY_PRIVATE_KEY=CHANGE_ME_BASE64_PEM_SINGLE_LINE
#
# Video BACKUP provider (Cloudinary) — optional. cloudinary.com → Dashboard.
# VIDEO_PROVIDER=auto
# CLOUDINARY_CLOUD_NAME=CHANGE_ME
# CLOUDINARY_API_KEY=CHANGE_ME
# CLOUDINARY_API_SECRET=CHANGE_ME
# CLOUDINARY_FOLDER=redi/videos
